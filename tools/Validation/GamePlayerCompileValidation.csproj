    <DefineConstants>UNITY_STANDALONE_WIN;ENABLE_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../AniBato/Assets/_Project/Scripts/Battle/**/*.cs" />
