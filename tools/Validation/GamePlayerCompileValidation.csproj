    <Reference Include="../../AniBato/Library/ScriptAssemblies/Unity.InputSystem.dll" />
    <Reference Include="../../AniBato/Library/ScriptAssemblies/UnityEngine.UI.dll" />
  </ItemGroup>
</Project>
